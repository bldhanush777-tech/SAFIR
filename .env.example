# NASA FireSafe AI Environment Configuration

# Database Configuration (PostgreSQL with pgvector or fallback SQLite)
# For local Docker setup:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nasa_firesafe
# For standalone local run without Docker:
# DATABASE_URL=sqlite:///./nasa_firesafe.db

# API Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG & AI Configuration
# Options: "local" (uses built-in semantic embedding & cosine ranking), "gemini", "openai"
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# RAG Similarity Threshold (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.55
